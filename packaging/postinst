#!/bin/sh
set -e

# Reload systemd so it sees the newly installed unit (only when systemd is up).
if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

# Create the local allowlist/denylist the daemon maintains (CUSTOM_LIST_DIR), so
# they exist before anything references them - Apache refuses to start when a
# RewriteMap file is missing. The daemon can't create them itself: the unit runs
# with ProtectSystem=full, which makes /etc read-only to the service.
# Apache's config directory differs by family, so use whichever one is present.
list_dir=/etc/apache2/crowdsec
if [ ! -d /etc/apache2 ] && [ -d /etc/httpd ]; then
    list_dir=/etc/httpd/crowdsec
fi
mkdir -p "$list_dir"
chmod 0755 "$list_dir"
for list in allowlist.txt denylist.txt; do
    [ -e "$list_dir/$list" ] || : > "$list_dir/$list"
    chmod 0644 "$list_dir/$list"
done
# The shipped default is the Debian path, so say something when it isn't the one
# we just used - otherwise the daemon would quietly maintain a different directory.
if [ "$list_dir" != /etc/apache2/crowdsec ]; then
    echo "crowdsec-apache2-bouncer: set CUSTOM_LIST_DIR=$list_dir in /etc/crowdsec/bouncers/crowdsec-apache2-bouncer.conf"
fi

# The service is intentionally NOT enabled or started on install: the shipped
# /etc/crowdsec/bouncers/crowdsec-apache2-bouncer.conf carries a placeholder API
# key, so a fresh install would only crash-loop. Set CROWDSEC_LAPI_URL and
# CROWDSEC_API_KEY there, then:
#     systemctl enable --now crowdsec-apache2-bouncer

exit 0
