#!/bin/sh
set -e

# Reload systemd so it sees the newly installed unit. Deliberately not gated on
# "$1": dpkg passes "configure" but rpm passes an install count (1 on install, 2 on
# upgrade), so checking for dpkg's convention alone means the reload never happens
# on RHEL-family hosts - and then the "systemctl enable --now" below fails with
# "Unit not found". An unconditional reload is idempotent and harmless on both.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

# Create the local allowlist/denylist the daemon maintains (CUSTOM_LIST_DIR), so
# they exist before anything references them - Apache refuses to start when a
# RewriteMap file is missing. The daemon can't create them itself: the unit runs
# with ProtectSystem=full, which makes /etc read-only to the service.
# Apache's config directory differs by family, so use whichever one is present.
list_dir=/etc/apache2/crowdsec
if [ ! -d /etc/apache2 ] && [ -d /etc/httpd ]; then
    list_dir=/etc/httpd/crowdsec
fi
mkdir -p "$list_dir"
chmod 0755 "$list_dir"
for list in allowlist.txt denylist.txt; do
    [ -e "$list_dir/$list" ] || : > "$list_dir/$list"
    chmod 0644 "$list_dir/$list"
done
# The shipped default is the Debian path, so say something when it isn't the one
# we just used - otherwise the daemon would quietly maintain a different directory.
if [ "$list_dir" != /etc/apache2/crowdsec ]; then
    echo "crowdsec-apache2-bouncer: set CUSTOM_LIST_DIR=$list_dir in /etc/crowdsec/bouncers/crowdsec-apache2-bouncer.conf"
fi

# Same reasoning for the CrowdSec map itself: Apache validates every RewriteMap
# file when it parses its config and refuses to start if one is missing, so an
# empty map has to exist before the include can safely be added. Only ever create
# it - an existing list is left exactly as it is. (The daemon does the same at
# startup, and builds the DBM there; this covers configuring Apache before the
# service has ever run.)
blocklist_dir=/var/lib/crowdsec-apache2-bouncer
mkdir -p "$blocklist_dir"
chmod 0755 "$blocklist_dir"
if [ ! -e "$blocklist_dir/blocklist.txt" ]; then
    : > "$blocklist_dir/blocklist.txt"
    chmod 0644 "$blocklist_dir/blocklist.txt"
fi

# On an upgrade the running daemon is still the old binary, so restart it - but
# only if it was already enabled, since a fresh install deliberately leaves the
# service off (see below).
if [ -d /run/systemd/system ] && systemctl is-enabled --quiet crowdsec-apache2-bouncer 2>/dev/null; then
    systemctl restart crowdsec-apache2-bouncer >/dev/null 2>&1 || true
fi

# The service is intentionally NOT enabled or started on a fresh install: the
# shipped /etc/crowdsec/bouncers/crowdsec-apache2-bouncer.conf carries a
# placeholder API key, so it would only crash-loop. Set CROWDSEC_LAPI_URL and
# CROWDSEC_API_KEY there, then:
#     systemctl enable --now crowdsec-apache2-bouncer

exit 0
